// MissileX Rocket Space — Admin/CMS backend schema.
//
// This is deliberately separate from the public-facing member system
// (Firebase Authentication, driving /login, /register, /dashboard, /profile
// on the existing frontend). This schema powers a Postgres-backed admin CMS
// — the `User` model here represents Admin/Editor staff accounts only, not
// public site visitors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

enum CareerStatus {
  OPEN
  CLOSED
  DRAFT
}

enum GalleryCategory {
  ROCKET_LAUNCHES
  SATELLITES_SPACECRAFT
  MISSILES
  DEFENCE_FORCES
  RESEARCH_LABS
}

enum ContactMessageStatus {
  NEW
  READ
  RESPONDED
}

// ---------------------------------------------------------------------------
// Admin / CMS staff accounts
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  research      Research[]
  news          News[]
  galleryImages Gallery[]

  @@index([email])
}

// ---------------------------------------------------------------------------
// Research
// ---------------------------------------------------------------------------

model Research {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  summary       String
  content       String   @db.Text
  category      String
  technologies  String[]
  pdfUrl        String?
  pdfPublicId   String?
  thumbnailUrl  String?
  thumbnailPublicId String?
  githubUrl     String?
  patentStatus  String?
  published     Boolean  @default(false)
  publishedAt   DateTime?
  authorId      String?
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// Programs
// ---------------------------------------------------------------------------

model Program {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  description        String
  details            String[]
  eligibility        String?
  applicationWindow  String?
  applicationDeadline DateTime?
  published          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Missiles
// ---------------------------------------------------------------------------

model Missile {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  type           String
  range          String
  guidance       String
  purpose        String
  history        String   @db.Text
  technology     String   @db.Text
  timeline       String[]
  specifications Json
  thumbnailUrl   String?
  thumbnailPublicId String?
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
}

// ---------------------------------------------------------------------------
// Rocket systems
// ---------------------------------------------------------------------------

model RocketSystem {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  category       String
  payload        String
  mission        String
  history        String   @db.Text
  launches       String[]
  specifications Json
  thumbnailUrl   String?
  thumbnailPublicId String?
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// Space systems (flagship missions)
// ---------------------------------------------------------------------------

model SpaceSystem {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  vehicle      String
  objective    String   @db.Text
  status       String
  description  String?  @db.Text
  thumbnailUrl String?
  thumbnailPublicId String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Technology (conceptual AI research tracks)
// ---------------------------------------------------------------------------

model Technology {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  category    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// News
// ---------------------------------------------------------------------------

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  tag         String
  imageUrl    String?
  imagePublicId String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  publishedAt DateTime?
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([featured])
}

// ---------------------------------------------------------------------------
// Gallery
// ---------------------------------------------------------------------------

model Gallery {
  id         String          @id @default(cuid())
  caption    String
  imageUrl   String
  imagePublicId String
  category   GalleryCategory
  credit     String
  license    String
  uploadedById String?
  uploadedBy User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([category])
}

// ---------------------------------------------------------------------------
// Careers
// ---------------------------------------------------------------------------

model Career {
  id                  String       @id @default(cuid())
  title               String
  slug                String       @unique
  location            String
  summary             String
  requirements        String[]
  applicationDeadline DateTime?
  externalApplyLink   String?
  status              CareerStatus @default(OPEN)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Contact messages
// ---------------------------------------------------------------------------

model ContactMessage {
  id                String                @id @default(cuid())
  name              String
  email             String
  phone             String
  organization      String?
  researchInterest  String
  message           String   @db.Text
  status            ContactMessageStatus  @default(NEW)
  createdAt         DateTime              @default(now())

  @@index([status])
  @@index([createdAt])
}
